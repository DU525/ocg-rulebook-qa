# ==================== 应用配置 ====================
SECRET_KEY=your-secret-key-change-in-production
DEBUG=false

# ==================== LLM Provider 选择 ====================
# 可选值: openai, minimax, custom
LLM_PROVIDER=minimax

# ==================== MiniMax 配置（当 LLM_PROVIDER=minimax 时使用） ====================
MINIMAX_API_KEY=your-minimax-api-key-here
MINIMAX_API_BASE=https://api.minimax.chat/v1
MODEL_NAME=abab6.5s-chat

# ==================== OpenAI 配置（当 LLM_PROVIDER=openai 时使用） ====================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4

# ==================== 自定义 OpenAI 兼容 API 配置（当 LLM_PROVIDER=custom 时使用） ====================
# OPENAI_API_KEY=sk-your-custom-api-key
# OPENAI_API_BASE=https://your-custom-api.com/v1
# OPENAI_MODEL_NAME=your-model-name

# ==================== 降级 Provider 配置 ====================
# 当主 provider 不可用时，自动降级到此 provider
FALLBACK_PROVIDER=minimax
FALLBACK_API_KEY=your-fallback-api-key-here
FALLBACK_API_BASE=https://api.minimax.chat/v1
FALLBACK_MODEL_NAME=abab6.5s-chat

# ==================== Streaming 配置 ====================
STREAMING_ENABLED=false
TEMPERATURE=0.3
MAX_TOKENS=1500
RETRIEVAL_TOP_K=5

# ==================== 嵌入模型配置 ====================
EMBEDDING_MODEL=BAAI/bge-m3

# ==================== 飞书通知配置 ====================
FEISHU_ENABLED=false
FEISHU_BOT_TOKEN=
FEISHU_CHAT_ID=
FEISHU_USER_ID=your-feishu-user-id-here
FEISHU_CLI_PATH=lark-cli

# ==================== Raw HTTP Provider 配置 ====================
# 使用纯 HTTP 实现（面试展示重点，不依赖 SDK）
# RAW_HTTP_ENABLED=true
# RAW_HTTP_PROVIDER=minimax  # 或 openai / custom

# ==================== 监控调度配置 ====================
MONITORING_ENABLED=true
MONITORING_HEALTH_CHECK_INTERVAL=5
MONITORING_METRICS_INTERVAL=15
MONITORING_ALERT_INTERVAL=30
MONITORING_CLEANUP_HOUR=2
MONITORING_TASKS_ENABLED=health_check,metrics,alerts,cleanup
MONITORING_SILENT=false
MONITORING_FRONTEND_URL=http://localhost:3011
MONITORING_BACKEND_URL=http://localhost:5000
MONITORING_ALERT_QPS_THRESHOLD=1000
MONITORING_ALERT_P99_THRESHOLD=5
MONITORING_ALERT_CACHE_HIT_THRESHOLD=0.5
MONITORING_ALERT_FAITHFULNESS_THRESHOLD=0.8