{
    "_note": "project_dir 相对启动目录解析；也可改为本机绝对路径",
    "project_dir": ".",
    "check_interval_seconds": 60,
    "max_restart_attempts": 3,
    "restart_delay_seconds": 5,
    "ports": {
        "3000": {
            "name": "Vite前端",
            "process": "node",
            "cwd": "frontend",
            "start_cmd": ["npm", "run", "dev"],
            "port": 3000
        },
        "5000": {
            "name": "Flask后端",
            "process": "python",
            "cwd": "backend",
            "start_cmd": ["python", "run.py"],
            "port": 5000
        }
    },
    "alert": {
        "enabled": true,
        "notify_mavis": true
    }
}