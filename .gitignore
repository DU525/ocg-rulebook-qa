!data/.gitkeep
vector_db/
*.faiss
*.index
*.npy
*.npz
*.pkl
*.pickle
*.bin
*.h5
*.parquet
*.arrow
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

