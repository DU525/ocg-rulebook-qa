# Layered by reason, not appended by accident.
#   1 secrets  2 python  3 node  4 build  5 data/vectors  6 models
#   7 logs     8 os/ide  9 tooling  10 generated output

# ---------------------------------------------------------------- 1. secrets
.env
.env.*
!.env.example
backend/.env
frontend/.env.local
*.pem
*.key
*.p12
*.keystore

# ----------------------------------------------------------------- 2. python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.venv/
venv/
env/
ENV/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage/

# ------------------------------------------------------------------- 3. node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vite/
.pnpm-store/

# ------------------------------------------------------------------ 4. build
dist/
build/
*.whl
frontend/dist/

# ------------------------------------------------- 5. data, vector stores, db
